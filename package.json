    "@neondatabase/auth": "^0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "stripe": "^22.6.2",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
