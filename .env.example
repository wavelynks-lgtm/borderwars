# Public browser configuration. Set this in Vercel, then rebuild.
VITE_MULTIPLAYER_URL=https://your-match-server.onrender.com
# SERVER ONLY: never prefix database credentials with VITE_.
# DATABASE_URL=postgresql://... (Supabase session pooler or Neon, SSL enabled)
# ALLOWED_ORIGINS=https://your-game.vercel.app
# MAX_ROOMS=1
# PORT=8787

# Optional store. Defaults OFF. All Stripe secrets belong on the server only.
# COMMERCE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_AD_FREE=price_...
# STRIPE_PRICE_SUPPORTER=price_...
# PUBLIC_APP_URL=https://your-game.example

# Optional menu ads. Defaults OFF; requires an approved AdSense account AND
# a configured Google-certified CMP exposing __tcfapi before ads can load.
VITE_ADS_ENABLED=false
# VITE_ADSENSE_CLIENT=ca-pub-...
# VITE_ADSENSE_SLOT=...

# Neon managed login: the same-origin proxy avoids third-party cookies.
# On Vercel this defaults to /api/auth; vercel.json points to this project's Neon Auth.
VITE_NEON_AUTH_URL=/api/auth
# On the match server only (Neon deploy populates these locally):
# NEON_AUTH_BASE_URL=https://your-neon-auth-host/neondb/auth
# NEON_AUTH_JWKS_URL=https://your-neon-auth-host/neondb/auth/.well-known/jwks.json
